# Copia questo file in .env.local per lo sviluppo (non va su git).
# In produzione queste variabili si impostano su EAS (vedi docs/PRODUZIONE.md).

# URL dell'API (output "ApiUrl" di `sam deploy`, oppure http://<IP-del-PC>:8787 con `npm run dev` nel backend)
EXPO_PUBLIC_API_URL=

# Deve coincidere con il parametro AppKey del backend (facoltativo)
EXPO_PUBLIC_APP_KEY=

# Pagina dell'informativa privacy sul sito
EXPO_PUBLIC_PRIVACY_URL=
